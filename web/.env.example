# Copia este archivo a .env.local y rellena los valores. .env.local no se sube a git.
# Sin las dos primeras variables la app usa los datos de prueba locales (.data/db.json).

# Supabase: Project Settings > API (o la salida de `npm run db:start` en local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Salta RLS: votos, límites de uso y borrar cuentas. Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Sal para los hashes de votos y de IP (límites de uso). Una cadena larga y aleatoria.
NOTICECAT_HASH_SALT=

# Opcional: contraseña de los usuarios de prueba que crea `npm run db:seed`
SEED_PASSWORD=

# Más adelante (milestone 5, cobrar a los medios): Stripe en modo test
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Email transaccional propio (Resend). En local, Supabase manda los emails de cuenta a Mailpit.
# RESEND_API_KEY=

# Panel de plataforma (/plataforma), solo IT: correos con acceso, separados por comas.
# La cuenta tiene que existir en Supabase Auth con el correo confirmado.
NOTICECAT_PLATFORM_ADMINS=
